# Copy this file to .env and fill in the values you want to use.

# Telegram
TELEGRAM_BOT_TOKEN=<set-locally>

# Optional AI providers for cover-letter generation.
# Configure either OpenRouter or Anthropic, or leave both blank to use the built-in fallback templates.
OPENROUTER_API_KEY=<set-locally>
JOBBLAST_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

ANTHROPIC_API_KEY=<set-locally>
JOBBLAST_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Required private access control.
# Comma-separated Telegram user IDs.
ALLOWED_USERS=<set-locally>

# Local companion app API.
# Generate a long random value and enter the same token in the Android app.
JOBBLAST_API_TOKEN=<set-locally>
# Required when more than one stored profile exists.
JOBBLAST_API_USER_ID=<set-locally>
JOBBLAST_API_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional OpenRouter dashboard metadata.
APP_URL=<set-locally>
APP_NAME=JobBlast

# JobBlast behavior.
# The scheduled scan runs daily at 08:00 Africa/Johannesburg from the bot runtime.
JOBBLAST_DEFAULT_MATCH_THRESHOLD=18
